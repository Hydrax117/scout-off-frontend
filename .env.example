# ─────────────────────────────────────────────────────────────────────────────
# ScoutOff — environment variable template
# Copy this file to .env.local and fill in the values before running the app.
#   cp .env.example .env.local
# Never commit .env.local or any file containing real secrets.
# ScoutOff — Environment Variable Template
# Copy this file: cp .env.example .env.local  (never commit .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar / Soroban ─────────────────────────────────────────────────────────

# Deployed ScoutOff Soroban contract address on Testnet or Mainnet.
# Obtain after running: stellar contract deploy --wasm ... --network testnet
NEXT_PUBLIC_CONTRACT_ID=

# Stellar network to connect to. Use 'testnet' for development and 'mainnet' for production.
NEXT_PUBLIC_NETWORK=testnet

# Stellar Horizon REST API endpoint for account queries and transaction submission.
# Testnet default: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint used to invoke and simulate smart contract calls.
# Testnet default: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-mainnet.stellar.org (or a private RPC node)
# Stellar network to target. Use 'testnet' for development, 'mainnet' for production.
NEXT_PUBLIC_NETWORK=testnet

# Stellar Horizon REST API endpoint. Used for account queries and transaction submission.
# Testnet default: https://horizon-testnet.stellar.org
# Mainnet:        https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for smart-contract reads and simulations.
# Testnet default: https://soroban-testnet.stellar.org
# Mainnet:        https://soroban-rpc.stellar.org
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────

# Pinata API key for server-side IPFS uploads (used in app/api/ipfs/upload).
# Obtain at: https://app.pinata.cloud/keys
# Pinata API key for IPFS uploads via the server-side proxy (app/api/ipfs/upload).
# Obtain from: https://app.pinata.cloud/keys — create a key with pinFileToIPFS scope.
# Server-side only — never expose to the client or commit to version control.
PINATA_API_KEY=

# Pinata API secret paired with PINATA_API_KEY.
# Server-side only — never expose to the client or commit to version control.
PINATA_SECRET=

# IPFS gateway base URL used to serve uploaded media (images, highlight reels).
# Pinata gateway example: https://gateway.pinata.cloud/ipfs
# Public gateway example: https://ipfs.io/ipfs
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────

# Shared rate limiter (lib/rateLimit.ts) — used by app/api/players/search
# and app/api/ipfs/upload to throttle requests per client IP.
# Public IPFS gateway used to serve stored media (player photos, highlight reels).
# Default: https://gateway.pinata.cloud/ipfs
# Any IPFS-compatible gateway works (e.g. https://ipfs.io/ipfs or a custom one).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# ── Shared Rate Limiter (lib/rateLimit.ts) ────────────────────────────────────
#
# Used by app/api/players/search and app/api/ipfs/upload to throttle requests
# per client IP. REQUIRED in production for the limiter to be globally
# authoritative across serverless instances (e.g. Vercel). Without a shared
# store each instance tracks its own counter so a client can exceed the real
# limit by roughly limit × N (where N = warm instance count).
#
# Upstash Redis (REST-based, no persistent TCP connection) closes that gap.
# If blank in production the app does NOT fail — it logs a console.error once
# and falls back to an in-memory per-instance limiter. That fallback is
# best-effort only and is NOT an authoritative global limit.
#
# Local dev/test: leave these blank. lib/rateLimit.ts automatically falls
# back to the same in-memory limiter, which is fully sufficient for a
# single local process — no Upstash account needed to develop or run tests.

# Upstash Redis REST URL. Obtain from your Upstash console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token paired with UPSTASH_REDIS_REST_URL.
# Server-side only — never expose to the client or commit to version control.
UPSTASH_REDIS_REST_TOKEN=

# ── Media proxy ───────────────────────────────────────────────────────────────

# Media proxy signed-URL secret (optional). When set, /api/media/[cid] enforces
# signed, time-limited URLs generated via lib/mediaUrlSigning.ts in addition to
# referrer gating. Leave blank locally — the proxy falls back to referrer-only
# gating when this is unset. Generate one with: openssl rand -hex 32
# Local dev / tests: leave blank — lib/rateLimit.ts falls back automatically.
# Obtain from: https://console.upstash.com — create a Redis database.

# Full REST URL of your Upstash Redis database (e.g. https://<db>.upstash.io).
UPSTASH_REDIS_REST_URL=

# Bearer token for the Upstash Redis REST API.
# Server-side only — never expose to the client or commit to version control.
UPSTASH_REDIS_REST_TOKEN=

# ── Media Proxy Signed-URL Secret ─────────────────────────────────────────────

# Optional secret used by /api/media/[cid] to issue signed, time-limited URLs
# (lib/mediaUrlSigning.ts). When set, every media URL is HMAC-signed and
# expires after a configurable window. Leave blank locally — the proxy falls
# back to referrer-only gating when this is unset.
# Generate with: openssl rand -hex 32
# Server-side only — never expose to the client or commit to version control.
MEDIA_URL_SIGNING_SECRET=

# ── Backend API ───────────────────────────────────────────────────────────────

# Base URL for the ScoutOff off-chain Node.js API (server/ directory).
# Used by client-side fetch calls. Default: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override for SSR/Server Component fetches (e.g. Docker Compose's
# http://mock-api:4000 container-internal hostname). Leave blank outside of
# docker-compose.yml — lib/api.ts falls back to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────

# Cloudflare Turnstile — bot-protection challenge on unauthenticated public
# forms (e.g. referral code generation). Leave blank to disable the
# challenge locally; the server-side check is skipped when its secret is
# unset (see server/.env.example).
# Obtain your site key at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Indexer ───────────────────────────────────────────────────────────────────

# Base URL for the off-chain event indexer query API (packages/indexer).
# Default: http://localhost:3001
# Base URL of the off-chain Node.js backend API (server/).
# Default for local development: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override for SSR / Server Component fetches (e.g. Docker Compose
# container-internal hostname: http://mock-api:4000). Leave blank outside of
# docker-compose — lib/api.ts falls back to NEXT_PUBLIC_API_URL when unset.
API_URL_INTERNAL=

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────

# Public site key for the Cloudflare Turnstile bot-protection widget shown on
# unauthenticated public forms (e.g. referral code generation). Leave blank to
# disable the challenge locally — the server-side check is skipped when its
# corresponding secret is unset (see server/.env.example).
# Obtain from: https://dash.cloudflare.com — Turnstile → Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Indexer Query API (packages/indexer) ─────────────────────────────────────

# Base URL of the off-chain event indexer API used to read on-chain events.
# Default for local development: http://localhost:3001
NEXT_PUBLIC_INDEXER_API_URL=http://localhost:3001

# ── Auth (SEP-10) ─────────────────────────────────────────────────────────────

# Stellar secret key used server-side to sign SEP-10 challenge transactions.
# Must be a valid Stellar secret key (starts with 'S').
# Server-side only — never expose to the client or commit to version control.
STELLAR_SECRET_KEY=

# Public domain of this deployment (without protocol), used in SEP-10 challenges.
# Example: scoutoff.app (production) or localhost:3000 (local dev)
NEXT_PUBLIC_DOMAIN=localhost:3000

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────

# Sentry DSN for client-side error monitoring (optional).
# Leave blank to disable Sentry entirely. Obtain at: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# Sentry organisation slug (build-time only — set as a CI/host secret).
# Leave blank locally to skip source-map upload during `next build`.
SENTRY_ORG=

# Sentry project slug paired with SENTRY_ORG.
SENTRY_PROJECT=

# Sentry auth token used to upload source maps during CI builds.
# Server-side only — never expose to the client or commit to version control.
SENTRY_AUTH_TOKEN=

# Sentry release identifier (e.g. a git SHA or semantic version tag).
# Automatically set in CI; leave blank locally.
SENTRY_RELEASE=

# ── Platform config ───────────────────────────────────────────────────────────

# XLM fee charged when a scout unlocks a player's contact details via pay-to-contact.
# Default: 1 (i.e. 1 XLM). Must be a positive number.
PLATFORM_CONTACT_FEE_XLM=1

# Stellar public key of the platform admin account authorised to manage validators,
# withdraw fees, and trigger the emergency pause. Starts with 'G'.
NEXT_PUBLIC_ADMIN_ADDRESS=

# ── Status page ───────────────────────────────────────────────────────────────

# Public status page URL (free-tier provider e.g. Instatus, Better Stack, UptimeRobot)
# monitoring the frontend, backend API, and Soroban RPC/Horizon endpoints.
# Leave blank to hide the live-status link on the /status page.
# Must be a valid Stellar secret key (starts with S).
# Server-side only — never expose to the client or commit to version control.
STELLAR_SECRET_KEY=

# Domain used in SEP-10 challenge transactions (must match the deployed origin).
# For local development use: localhost:3000
NEXT_PUBLIC_DOMAIN=localhost:3000

# ── Error Monitoring (Sentry) ─────────────────────────────────────────────────

# Sentry DSN (Data Source Name) for client-side error reporting. Leave blank to
# disable Sentry entirely. Obtain from: https://sentry.io — project → Settings → DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry organisation slug (build-time only — set as a CI/host secret).
# Leave blank locally to skip the source-map upload step during `next build`.
SENTRY_ORG=

# Sentry project slug (build-time only — set as a CI/host secret).
SENTRY_PROJECT=

# Sentry auth token for source-map uploads (build-time only).
# Server-side only — never expose to the client or commit to version control.
SENTRY_AUTH_TOKEN=

# Sentry release identifier injected at build time (e.g. a git SHA or semver tag).
SENTRY_RELEASE=

# ── Platform Config ───────────────────────────────────────────────────────────

# XLM fee charged to scouts for pay-to-contact unlocks. Default: 1 (1 XLM).
PLATFORM_CONTACT_FEE_XLM=1

# Stellar public key of the platform admin wallet. Any connected wallet matching
# this address gets access to the /admin panel. Leave blank during development.
# WARNING: if unset in production, any connected wallet is treated as admin.
NEXT_PUBLIC_ADMIN_ADDRESS=

# ── Status Page ───────────────────────────────────────────────────────────────

# URL of the public status page (e.g. Instatus, Better Stack, UptimeRobot) that
# monitors the frontend, backend API, and Stellar endpoints. Leave blank to hide
# the live-status link on the /status page.
NEXT_PUBLIC_STATUS_PAGE_URL=

# ── PWA / App URL ─────────────────────────────────────────────────────────────

# Canonical public URL of the deployed app (no trailing slash).
# Used for manifest start_url, Open Graph tags, and sitemap generation.
# Example: https://scoutoff.app
NEXT_PUBLIC_APP_URL=https://scoutoff.app

# ── SEP-10 challenge server ───────────────────────────────────────────────────

# Stellar secret key for the SEP-10 challenge signing server.
# Server-side only — never expose to the client or commit to version control.
SEP10_SERVER_KEY=

# Home domain asserted in SEP-10 challenges (without protocol).
# Must match the domain registered with the wallet (e.g. scoutoff.app).
# Canonical public URL of the app. Used for PWA manifest start_url, Open Graph
# tags, and sitemap generation. Update to your production domain before deploying.
NEXT_PUBLIC_APP_URL=https://scoutoff.app

# ── SEP-10 Challenge Server ───────────────────────────────────────────────────

# Stellar secret key for the SEP-10 server that issues and verifies challenges.
# May be the same key as STELLAR_SECRET_KEY in simple setups.
# Server-side only — never expose to the client or commit to version control.
SEP10_SERVER_KEY=

# Home domain asserted in SEP-10 challenge transactions. Must match the deployed
# origin (e.g. scoutoff.app). For local development use: localhost:3000
SEP10_HOME_DOMAIN=

# Comma-separated list of allowed Origin headers for the SEP-10 POST endpoint
# (app/api/auth/sep10/route.ts). REQUIRED before deploying to any non-local
# environment. If unset in production the route fails closed (403). Example:
# SEP10_ALLOWED_ORIGINS=https://scoutoff.app,https://www.scoutoff.app
# Leave blank locally — dev falls back to http://<NEXT_PUBLIC_DOMAIN>.
SEP10_ALLOWED_ORIGINS=

# ── Runtime ───────────────────────────────────────────────────────────────────

# Node.js environment. Set automatically by Next.js ('development', 'production', 'test').
# Do not set manually unless you have a specific reason to override it.
NODE_ENV=

# Port the Next.js server listens on. Defaults to 3000 if unset.
PORT=

# Canonical base URL for this deployment (protocol + domain, no trailing slash).
# Used as a fallback single-origin entry in SEP10_ALLOWED_ORIGINS.
# Example: https://scoutoff.app
# ── Runtime (set automatically) ───────────────────────────────────────────────

# Node.js environment. Set automatically by Next.js / your host (development,
# production, test). Do not set this manually in .env.local.
NODE_ENV=

# TCP port the server listens on. Set by your host platform in production.
# Leave blank locally — Next.js defaults to 3000.
PORT=

# Canonical base URL of the frontend (e.g. https://scoutoff.app). Used as a
# convenience single-origin entry folded into SEP10_ALLOWED_ORIGINS and for
# absolute URL generation. Leave blank to derive from NEXT_PUBLIC_DOMAIN.
NEXT_PUBLIC_BASE_URL=

# ── Feature Flags ─────────────────────────────────────────
#
# Set any of these to "1" or "true" to enable the corresponding feature.
# When unset or set to "0" / "false", the feature is disabled.
# These flags are read by lib/featureFlags.ts → isFeatureEnabled().

# Enables the "Download my data" self-service export in the player
# dashboard. Exports profile vitals, progress level, milestone history,
# and IPFS media references as a JSON file.
#   NEXT_PUBLIC_FEATURE_DATA_EXPORT=1
NEXT_PUBLIC_FEATURE_DATA_EXPORT=

# Enables dark mode toggle in the navigation bar. When disabled, the
# app always renders in dark mode (the default theme).
#   NEXT_PUBLIC_FEATURE_DARK_MODE_TOGGLE=1
NEXT_PUBLIC_FEATURE_DARK_MODE_TOGGLE=

# Enables in-app notification system for milestone approvals and
# scout messages. Disabled by default until the feature is complete.
#   NEXT_PUBLIC_FEATURE_IN_APP_NOTIFICATIONS=1
NEXT_PUBLIC_FEATURE_IN_APP_NOTIFICATIONS=
