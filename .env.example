# ─────────────────────────────────────────────────────────────────────────────
# ScoutOff — environment variable template
# Copy this file to .env.local and fill in the values before running the app.
#   cp .env.example .env.local
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar / Soroban ─────────────────────────────────────────────────────────

# Deployed ScoutOff Soroban contract address on Testnet or Mainnet.
# Obtain after running: stellar contract deploy --wasm ... --network testnet
NEXT_PUBLIC_CONTRACT_ID=

# Stellar network to connect to. Use 'testnet' for development and 'mainnet' for production.
NEXT_PUBLIC_NETWORK=testnet

# Stellar Horizon REST API endpoint for account queries and transaction submission.
# Testnet default: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint used to invoke and simulate smart contract calls.
# Testnet default: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-mainnet.stellar.org (or a private RPC node)
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────

# Pinata API key for server-side IPFS uploads (used in app/api/ipfs/upload).
# Obtain at: https://app.pinata.cloud/keys
# Server-side only — never expose to the client or commit to version control.
PINATA_API_KEY=

# Pinata API secret paired with PINATA_API_KEY.
# Server-side only — never expose to the client or commit to version control.
PINATA_SECRET=

# IPFS gateway base URL used to serve uploaded media (images, highlight reels).
# Pinata gateway example: https://gateway.pinata.cloud/ipfs
# Public gateway example: https://ipfs.io/ipfs
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────

# Shared rate limiter (lib/rateLimit.ts) — used by app/api/players/search
# and app/api/ipfs/upload to throttle requests per client IP.
#
# REQUIRED in production for the limiter to be globally authoritative.
# Serverless deployments (e.g. Vercel) run multiple warm instances of the
# same function behind a load balancer; without a shared store each
# instance would track its own counter, so a client spread across N
# instances could get roughly `limit * N` requests through instead of
# `limit`. Upstash Redis (REST-based, no persistent TCP connection needed)
# closes that gap by giving every instance the same counter.
#
# If these are left blank in production, the app does NOT fail — it logs a
# loud console.error once and falls back to an in-memory, per-instance
# limiter so routes keep working, but that fallback is best-effort only and
# is NOT an authoritative global limit. Treat "blank in production" as a
# misconfiguration to fix, not a supported long-term state.
#
# Local dev/test: leave these blank. lib/rateLimit.ts automatically falls
# back to the same in-memory limiter, which is fully sufficient for a
# single local process — no Upstash account needed to develop or run tests.

# Upstash Redis REST URL. Obtain from your Upstash console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token paired with UPSTASH_REDIS_REST_URL.
# Server-side only — never expose to the client or commit to version control.
UPSTASH_REDIS_REST_TOKEN=

# ── Media proxy ───────────────────────────────────────────────────────────────

# Media proxy signed-URL secret (optional). When set, /api/media/[cid] enforces
# signed, time-limited URLs generated via lib/mediaUrlSigning.ts in addition to
# referrer gating. Leave blank locally — the proxy falls back to referrer-only
# gating when this is unset. Generate one with: openssl rand -hex 32
# Server-side only — never expose to the client or commit to version control.
MEDIA_URL_SIGNING_SECRET=

# ── Backend API ───────────────────────────────────────────────────────────────

# Base URL for the ScoutOff off-chain Node.js API (server/ directory).
# Used by client-side fetch calls. Default: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override for SSR/Server Component fetches (e.g. Docker Compose's
# http://mock-api:4000 container-internal hostname). Leave blank outside of
# docker-compose.yml — lib/api.ts falls back to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────

# Cloudflare Turnstile — bot-protection challenge on unauthenticated public
# forms (e.g. referral code generation). Leave blank to disable the
# challenge locally; the server-side check is skipped when its secret is
# unset (see server/.env.example).
# Obtain your site key at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Indexer ───────────────────────────────────────────────────────────────────

# Base URL for the off-chain event indexer query API (packages/indexer).
# Default: http://localhost:3001
NEXT_PUBLIC_INDEXER_API_URL=http://localhost:3001

# ── Auth (SEP-10) ─────────────────────────────────────────────────────────────

# Stellar secret key used server-side to sign SEP-10 challenge transactions.
# Must be a valid Stellar secret key (starts with 'S').
# Server-side only — never expose to the client or commit to version control.
STELLAR_SECRET_KEY=

# Public domain of this deployment (without protocol), used in SEP-10 challenges.
# Example: scoutoff.app (production) or localhost:3000 (local dev)
NEXT_PUBLIC_DOMAIN=localhost:3000

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────

# Sentry DSN for client-side error monitoring (optional).
# Leave blank to disable Sentry entirely. Obtain at: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# Sentry organisation slug (build-time only — set as a CI/host secret).
# Leave blank locally to skip source-map upload during `next build`.
SENTRY_ORG=

# Sentry project slug paired with SENTRY_ORG.
SENTRY_PROJECT=

# Sentry auth token used to upload source maps during CI builds.
# Server-side only — never expose to the client or commit to version control.
SENTRY_AUTH_TOKEN=

# Sentry release identifier (e.g. a git SHA or semantic version tag).
# Automatically set in CI; leave blank locally.
SENTRY_RELEASE=

# ── Platform config ───────────────────────────────────────────────────────────

# XLM fee charged when a scout unlocks a player's contact details via pay-to-contact.
# Default: 1 (i.e. 1 XLM). Must be a positive number.
PLATFORM_CONTACT_FEE_XLM=1

# Stellar public key of the platform admin account authorised to manage validators,
# withdraw fees, and trigger the emergency pause. Starts with 'G'.
NEXT_PUBLIC_ADMIN_ADDRESS=

# ── Status page ───────────────────────────────────────────────────────────────

# Public status page URL (free-tier provider e.g. Instatus, Better Stack, UptimeRobot)
# monitoring the frontend, backend API, and Soroban RPC/Horizon endpoints.
# Leave blank to hide the live-status link on the /status page.
NEXT_PUBLIC_STATUS_PAGE_URL=

# ── PWA / App URL ─────────────────────────────────────────────────────────────

# Canonical public URL of the deployed app (no trailing slash).
# Used for manifest start_url, Open Graph tags, and sitemap generation.
# Example: https://scoutoff.app
NEXT_PUBLIC_APP_URL=https://scoutoff.app

# ── SEP-10 challenge server ───────────────────────────────────────────────────

# Stellar secret key for the SEP-10 challenge signing server.
# Server-side only — never expose to the client or commit to version control.
SEP10_SERVER_KEY=

# Home domain asserted in SEP-10 challenges (without protocol).
# Must match the domain registered with the wallet (e.g. scoutoff.app).
SEP10_HOME_DOMAIN=

# SEP-10 origin allow-list (comma-separated full origins, e.g.
# "https://scoutoff.app,https://www.scoutoff.app"). This is the source of
# truth for which Origin headers app/api/auth/sep10/route.ts will accept on
# POST — it is REQUIRED before deploying to any non-local environment. If
# unset in production, the route fails closed (403) rather than trusting the
# incoming request's own Host header. NEXT_PUBLIC_BASE_URL, if set, is still
# honored as a convenience single-origin entry folded into this allow-list.
# Leave blank locally — dev falls back to http://<NEXT_PUBLIC_DOMAIN>.
SEP10_ALLOWED_ORIGINS=

# ── Runtime ───────────────────────────────────────────────────────────────────

# Node.js environment. Set automatically by Next.js ('development', 'production', 'test').
# Do not set manually unless you have a specific reason to override it.
NODE_ENV=

# Port the Next.js server listens on. Defaults to 3000 if unset.
PORT=

# Canonical base URL for this deployment (protocol + domain, no trailing slash).
# Used as a fallback single-origin entry in SEP10_ALLOWED_ORIGINS.
# Example: https://scoutoff.app
NEXT_PUBLIC_BASE_URL=
