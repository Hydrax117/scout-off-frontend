# Port the backend HTTP server listens on.
PORT=4000

# Origin allowed to make cross-origin requests (the frontend dev server).
CORS_ORIGIN=http://localhost:3000

# Path to the SQLite database file. Defaults to ./data/scout-off.db
# (relative to server/) when unset.
DB_PATH=./data/scout-off.db

# Cloudflare Turnstile secret key, used to verify the challenge token
# submitted with POST /referrals/generate. Leave blank to skip verification
# (local dev / tests).
TURNSTILE_SECRET_KEY=
